rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- ENTITY VALIDATORS ---
    function isValidProject(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.versions is list && data.versions.size() <= 100 &&
             data.userId == request.auth.uid;
    }

    function isValidDataItem(data) {
      return data.key is string && data.key.size() <= 50 &&
             data.value is string && data.value.size() <= 10000 &&
             data.userId == request.auth.uid;
    }

    function isValidDeployment(data) {
      return data.projectId is string && isValidId(data.projectId) &&
             data.code is string && data.code.size() <= 1048576 && // 1MB Limit
             data.authorId == request.auth.uid;
    }

    function isValidPreferences(data) {
      return data.theme in ['dark', 'light', 'brutalist'] &&
             data.autoSave is bool &&
             data.defaultViewport in ['desktop', 'tablet', 'mobile'];
    }

    // --- COLLECTION MATCHES ---

    // User Data Scoped
    match /users/{userId} {
      match /preferences/main {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPreferences(incoming()) && 
                                incoming().updatedAt == request.time;
      }

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(incoming()) && isValidId(projectId);
        allow update: if isOwner(userId) && isValidProject(incoming()) && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'versions', 'currentVersionIndex', 'activeFile', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      match /cms_data/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDataItem(incoming()) && isValidId(itemId);
        allow update: if isOwner(userId) && isValidDataItem(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['key', 'value']);
        allow delete: if isOwner(userId);
      }
    }

    // Public Deployments
    match /deployments/{deployId} {
      allow read: if true; // Public access
      allow create: if isVerified() && isValidDeployment(incoming()) && isValidId(deployId) && 
                      incoming().createdAt == request.time;
      allow update, delete: if isOwner(existing().authorId);
    }
  }
}
